# Hardened npm 12 configuration
# Maximum-lockdown profile based on the supplied npm v12 Config documentation.
#
# WARNING:
# - This intentionally breaks packages that require install lifecycle scripts.
# - It also blocks git, remote URL, local tarball, and local directory dependencies.
# - Relax individual controls per project only after review.

# ---- Registry / transport ----
registry=https://registry.npmjs.org/
strict-ssl=true

# Force lockfile registry URLs through the configured registry.
replace-registry-host=always

# ---- Dependency source restrictions ----
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# ---- Install-time code execution ----
# Strongest setting: dependency lifecycle scripts do not execute.
ignore-scripts=true

# Defense in depth: never bypass script policy.
dangerously-allow-all-scripts=false

# If ignore-scripts is later relaxed, make unreviewed script policy violations fail.
strict-allow-scripts=true

# Keep approved script entries version-pinned if npm approve-scripts is used.
allow-scripts-pin=true

# ---- Dependency resolution integrity ----
package-lock=true
save-exact=true
strict-peer-deps=true
legacy-peer-deps=false
engine-strict=true

# Treat unknown .npmrc keys as errors (helps catch typos / ineffective controls).
strict-npmrc=true

# Never disable npm safety checks globally.
force=false

# ---- Vulnerability auditing ----
audit=true
audit-level=low

# ---- Release-age guard ----
# Reduces exposure to freshly published supply-chain attacks.
# Tradeoff: can delay installation of newly released security fixes.
min-release-age=7
